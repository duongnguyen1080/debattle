{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "@devvit/public-api/devvit.tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "src/client", "src/server"]
}
