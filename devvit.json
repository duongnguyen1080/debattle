{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "debattle-game",
  "permissions": {
    "http": {
      "enable": true,
      "domains": ["api.openai.com", "dlukhaogmdtzopmbehvt.supabase.co"]
    }
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "regular",
        "inline": true
      },
      "game": {
        "entry": "index.html",
        "height": "tall"
      }
    }
  },
  "blocks": {
    "entry": "src/main.tsx"
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "media": {
    "dir": "assets"
  }
}
